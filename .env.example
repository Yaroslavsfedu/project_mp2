# ================== База данных ==================
# Локальный режим (по умолчанию): SQLite, файл в backend/data
# DATABASE_URL=sqlite+aiosqlite:////абсолютный/путь/idp.db  (по умолчанию backend/data/idp.db)
# Продуктивный контур: PostgreSQL 16 + pgvector
# DATABASE_URL=postgresql+asyncpg://idp:idp@postgres:5432/idp

# ================== Безопасность ==================
SECRET_KEY=change-me-in-production-please-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MAX_UPLOAD_MB=50
CORS_ORIGINS=*
# Защита от перебора паролей и флуда загрузками (на процесс API)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=30

# ================== Хранилище ==================
# local — файловая система, minio — S3-совместимое хранилище
STORAGE_BACKEND=local
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=idpminio
MINIO_SECRET_KEY=idpminio-secret
MINIO_BUCKET=idp-documents
MINIO_SECURE=false
PRESIGNED_URL_TTL_MINUTES=15

# ================== Очереди задач ==================
# inline — asyncio-задачи в процессе API, celery — внешний воркер + Redis
QUEUE_BACKEND=inline
REDIS_URL=redis://redis:6379/0

# ================== Локальный ИИ (Ollama) ==================
# Локальный запуск (ollama serve на этой же машине): http://localhost:11434
# В Docker Compose значение переопределяется на http://ollama:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_VISION_MODEL=qwen2-vl:7b
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
LLM_TIMEOUT_SECONDS=180
# Если Ollama недоступна — включить эвристический fallback (правила + regex)
LLM_FALLBACK_ENABLED=true

# ================== OCR ==================
# auto | tesseract | ollama | native
#   auto      — Tesseract, если установлен, иначе локальная VLM (qwen2-vl/llava)
#   tesseract — только Tesseract (CPU, быстро, есть координаты слов)
#   ollama    — только VLM: сканы, фото, рукописный текст (нужна GPU)
#   native    — только текстовый слой PDF/DOCX (OCR отключён)
OCR_ENGINE=auto
OCR_LANGUAGES=rus+eng
OCR_DPI=150
PREPROCESS_ENABLED=true

# ================== Прочее ==================
DEBUG=true
SEED_DEMO=true

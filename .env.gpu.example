# Конфигурация для ПК с GPU (NVIDIA). Скопируйте в .env и проверьте пути.
#
# Проверка:  python scripts/check_env.py
# Модели:    ./scripts/pull_models.sh        (WITH_VISION=1 — добавить VLM для OCR)

# ---------- Локальная LLM ----------
OLLAMA_URL=http://localhost:11434
# 6–8 ГБ VRAM — 7B; 10–12 ГБ — 14B; 20+ ГБ — 14B/32B (см. docs/GPU_DEPLOY.md)
OLLAMA_MODEL=qwen2.5:7b-instruct
EMBEDDING_MODEL=bge-m3
# VLM для распознавания сканов и рукописного текста (нужно 6–10 ГБ VRAM)
OLLAMA_VISION_MODEL=qwen2-vl:7b
# Дольше таймаут: на GPU первый ответ включает загрузку весов в VRAM
LLM_TIMEOUT_SECONDS=300

# ---------- OCR ----------
# auto: Tesseract → VLM → «нужен OCR»; ollama: только VLM; tesseract: только Tesseract
OCR_ENGINE=auto
OCR_LANGUAGES=rus+eng
PREPROCESS_ENABLED=true

# ---------- Хранилище и очередь ----------
STORAGE_BACKEND=local
QUEUE_BACKEND=inline
DATA_DIR=./data

# ---------- Безопасность ----------
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------- Демо ----------
SEED_DEMO=true
